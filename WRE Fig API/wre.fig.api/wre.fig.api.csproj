<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wre.Fig.Api</RootNamespace>
    <AssemblyName>wre.fig.api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Auth middleware + Swagger only — all other packages live in sub-projects -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\wre.fig.domain\wre.fig.domain.csproj" />
    <ProjectReference Include="..\wre.fig.data\wre.fig.data.csproj" />
    <ProjectReference Include="..\wre.fig.services\wre.fig.services.csproj" />
  </ItemGroup>

</Project>

    "Audience":    "wre.fig.ui",
    "ExpiryHours": 8
  },
  "Cors": {
    "AllowedOrigins": [ "OVERRIDE_IN_AZURE_APP_SERVICE_CONFIGURATION" ]
  },
  "AzureCommunicationServices": {
    "ConnectionString": "OVERRIDE_IN_AZURE_APP_SERVICE_CONFIGURATION",
    "SenderAddress":    "OVERRIDE_IN_AZURE_APP_SERVICE_CONFIGURATION"
  },
  "Notifications": {
    "ComplianceThresholdPct": 75.0,
    "DailyCheckHourUtc": 8
  },
  "Logging": {
    "LogLevel": {
      "Default":                "Warning",
      "Microsoft.AspNetCore":   "Warning"
    }
  },
  "AllowedHosts": "*"

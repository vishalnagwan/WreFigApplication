{
  "App": {
    "Title": "FIG",
    "FullTitle": "FIG (Field Information Guide)"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:wrefigdemoapp-server.database.windows.net,1433;Database=WreFig;User ID=wrefigdemoapp-server-admin;Password=<sql-admin-password>;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=true;Command Timeout=120"
  },
  "Jwt": {
    "Key":         "OVERRIDE_IN_AZURE_APP_SERVICE_CONFIGURATION",

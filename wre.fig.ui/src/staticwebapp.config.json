{
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": [ "anonymous" ]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [ "/assets/*", "*.css", "*.js", "*.ico", "*.png", "*.svg", "*.woff", "*.woff2", "*.ttf" ]
  },
  "globalHeaders": {
    "Cache-Control": "no-store"
  }
}

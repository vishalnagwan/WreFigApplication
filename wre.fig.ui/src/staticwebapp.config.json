{
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": [ "anonymous" ]
    },
    {
      "route": "/*",
      "rewrite": "/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [ "/assets/*", "*.css", "*.js", "*.ico", "*.png", "*.svg" ]
  },
  "globalHeaders": {
    "Cache-Control": "no-store"
  }
}
